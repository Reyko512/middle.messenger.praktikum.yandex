{{{inputs}}}
<div class='chat-settings__actions'>
  <button class='chat-settings__submit' type='submit' data-action='add'>Add user</button>
  <button
    class='chat-settings__submit chat-settings__submit_secondary'
    type='submit'
    data-action='remove'
  >
    Remove user
  </button>
</div>
<p class='chat-settings__error'>{{error}}</p>
