{{#if senderName}}
  <p class="message-item__sender">{{senderName}}</p>
{{/if}}
{{#if isFile}}
  {{#if fileUrl}}
    {{#if isImage}}
      <div class="message-item__image-frame">
        <img
          class="message-item__image"
          src="{{fileUrl}}"
          alt="{{fileName}}"
          loading="lazy"
        />
        <button
          class="message-item__download message-item__download_overlay"
          type="button"
          data-role="download-file"
          aria-label="Download {{fileName}}"
          title="Download {{fileName}}"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 3V14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M7 10L12 15L17 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M5 19H19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
    {{else}}
      <button
        class="message-item__attachment"
        type="button"
        data-role="download-file"
        aria-label="Download {{fileName}}"
        title="Download {{fileName}}"
      >
        <span class="message-item__file-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
            <path d="M8 3H14L19 8V20C19 20.55 18.55 21 18 21H8C7.45 21 7 20.55 7 20V4C7 3.45 7.45 3 8 3Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
            <path d="M14 3V8H19" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="message-item__file-meta">
          <span class="message-item__file-name">{{fileName}}</span>
          <span class="message-item__file-extension">{{fileExtension}}</span>
        </span>
        <span class="message-item__download" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
            <path d="M12 3V14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M7 10L12 15L17 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M5 19H19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </span>
      </button>
    {{/if}}
  {{else}}
    <p class="message-item__content">{{content}}</p>
  {{/if}}
{{else}}
  <p class="message-item__content">{{content}}</p>
{{/if}}
<time class="message-item__time">{{time}}</time>
