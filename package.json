{
  "name": "middle.messenger.praktikum.yandex",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "v25.2.1"
  },
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build --emptyOutDir",
    "preview": "vite preview --port 3000",
    "start": "npm run build && npm run preview",
    "prepare": "husky",
    "test": "tsx ./node_modules/mocha/bin/mocha.js --config .mocharc.json",
    "lint:style": "stylelint **/*.scss",
    "lint:style-fix": "stylelint **/*.scss --fix",
    "lint:code": "eslint --config ./eslint.config.js \"src/**/*.ts\"",
    "lint": "npm run lint:code && npm run lint:style",
    "lint:fix": "eslint --config ./eslint.config.js \"src/**/*.ts\" --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/chai": "^5.2.3",
    "@types/jsdom": "^27.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.4.0",
    "chai": "^6.2.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "handlebars": "^4.7.8",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "sass": "^1.98.0",
    "stylelint": "^17.4.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.3.1",
    "vite-plugin-handlebars": "^2.0.0"
  },
  "dependencies": {
    "uuid": "^13.0.0"
  },
  "overrides": {
    "table": {
      "ajv": "^8.18.0"
    },
    "diff": "^8.0.3",
    "immutable": "^5.1.5",
    "minimatch": "^10.2.4",
    "rollup": "^4.59.0",
    "serialize-javascript": "^7.0.4"
  }
}
